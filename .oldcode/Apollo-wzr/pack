#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLANNING_DIR="$ROOT_DIR/modules/planning"
PROFILE_DIR="$ROOT_DIR/profiles/default"

if [[ ! -d "$PLANNING_DIR" ]]; then
  echo "missing directory: $PLANNING_DIR" >&2
  exit 1
fi

if [[ ! -d "$PROFILE_DIR" ]]; then
  echo "missing directory: $PROFILE_DIR" >&2
  exit 1
fi

next_number=1
while [[ "$next_number" -le 99 ]]; do
  archive_name="$(printf "pack%02d.tar.gz" "$next_number")"
  if [[ ! -e "$ROOT_DIR/$archive_name" ]]; then
    break
  fi
  next_number=$((next_number + 1))
done

if [[ "$next_number" -gt 99 ]]; then
  echo "no available archive name from pack01.tar.gz to pack99.tar.gz" >&2
  exit 1
fi

echo "creating $archive_name from modules/planning and profiles/default"
tar -zcvf "$ROOT_DIR/$archive_name" -C "$ROOT_DIR" modules/planning profiles/default
echo "created: $ROOT_DIR/$archive_name"
